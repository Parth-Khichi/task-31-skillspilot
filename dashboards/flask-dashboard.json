{
  "id": null,
  "uid": "flask-monitoring",
  "title": "Flask API Monitoring Dashboard",
  "tags": ["flask", "prometheus", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",

  "panels": [

    {
      "id": 1,
      "title": "Total API Requests",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(flask_http_requests_total)",
          "legendFormat": "Total Requests",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "API Request Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(flask_http_requests_total[1m]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "API Latency (95th Percentile)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(flask_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "95th Percentile",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "API Error Rate (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "100 * sum(rate(flask_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(flask_http_requests_total[5m])), 0.000001)",
          "legendFormat": "Error Rate %",
          "refId": "A"
        }
      ]
    }

  ],

  "annotations": {
    "list": []
  },

  "links": [],

  "time": {
    "from": "now-15m",
    "to": "now"
  },

  "timepicker": {},

  "refresh": "5s"
}